# Copy to .env.local and fill in real values. Never commit .env.local.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys). Local values: `supabase status`.
# The publishable key is safe in the browser; the secret key bypasses RLS (server only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Cloud project ref (the id in https://<ref>.supabase.co), used by `supabase link`
SUPABASE_PROJECT_REF=

# Cloudflare R2 (photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=desinetwork-photos
NEXT_PUBLIC_R2_PUBLIC_URL=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM="Desinetwork <no-reply@desinetwork.co>"

# Twilio Verify (SMS) - configured inside Supabase Auth phone settings;
# listed here for reference/tests only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Stripe (test mode while building)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI (MVP 8 - leave empty until then)
AI_PROVIDER=
AI_API_KEY=
