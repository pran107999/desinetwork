{
  "name": "desinetwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check:cloud": "SUPABASE_TARGET=cloud vitest run --config vitest.integration.config.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --lang typescript --local > lib/db/types.ts.tmp && mv lib/db/types.ts.tmp lib/db/types.ts || (rm -f lib/db/types.ts.tmp; exit 1)",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  }
}
